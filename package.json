{
  "name": "servicios-ran",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:external": "E2E_SKIP_WEB_SERVER=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "supabase:bootstrap": "cd ./node_modules/supabase && node scripts/postinstall.js",
    "supabase:functions:deploy:r2": "supabase functions deploy r2-upload --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\" && supabase functions deploy r2-presigned-put --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\" && supabase functions deploy r2-presigned-get --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\" && supabase functions deploy r2-delete --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\"",
    "supabase:functions:deploy:admin-create-tecnico": "supabase functions deploy admin-create-tecnico --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\"",
    "supabase:functions:deploy:admin-reset-empleado-password": "supabase functions deploy admin-reset-empleado-password --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\"",
    "supabase:functions:deploy:admin": "supabase functions deploy admin-create-tecnico --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\" && supabase functions deploy admin-reset-empleado-password --no-verify-jwt --project-ref \"$SUPABASE_PROJECT_REF\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.47.2",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.20.5",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.9",
    "dexie-react-hooks": "^1.1.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "supabase": "^2.84.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0"
  }
}
