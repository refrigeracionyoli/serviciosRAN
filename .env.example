# Supabase - obtener desde Project Settings > API en el dashboard de Supabase.
# Usa valores del proyecto correspondiente al ambiente: local, staging o produccion.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=SUPABASE_ANON_PUBLIC_KEY

# NUNCA poner aqui las Edge Function secrets.
# Van en Supabase Dashboard > Edge Functions > Secrets o en GitHub/Vercel Secrets.
# SUPABASE_SERVICE_ROLE_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ran-evidencias
# ALLOWED_ORIGINS=https://serviciosran.com.mx,https://www.serviciosran.com.mx
